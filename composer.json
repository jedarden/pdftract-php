{
    "name": "jedarden/pdftract",
    "description": "PHP SDK for pdftract PDF processing service",
    "type": "library",
    "license": "MIT",
    "require": {
        "php": ">=8.2",
        "psr/log": "^3.0"
    },
    "require-dev": {
        "phpunit/phpunit": "^10.0"
    },
    "autoload": {
        "psr-4": {
            "Jedarden\\Pdftract\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Jedarden\\Pdftract\\Tests\\": "tests/"
        }
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
